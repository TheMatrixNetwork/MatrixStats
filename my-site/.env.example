# Copy this file to .env (or my-site.env) and fill in the values for local dev.
# Anything sensitive should NEVER be committed.

PORT=8787
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Switch DB_DRIVER to "sqlite" for a zero-setup local DB; otherwise MariaDB/MySQL.
DB_DRIVER=mariadb
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=minecraft

# --- Session / cookies ----------------------------------------------------
JWT_SECRET=dev-change-this
SESSION_TTL_MINUTES=60
REMEMBER_TTL_DAYS=7
COOKIE_SAMESITE=lax
COOKIE_SECURE=0

# --- Admins ---------------------------------------------------------------
# Comma-separated lowercase usernames that get admin powers in the site.
ADMIN_USERS=

# --- Auth provider --------------------------------------------------------
# "authme"        -> delegates verify / change-password to the MatrixStats
#                    Bukkit plugin over HTTPS (recommended).
# "matrix_logins" -> stores its own bcrypt logins in MATRIX_TABLE.
AUTH_PROVIDER=authme

# Matrix logins table (only used when AUTH_PROVIDER=matrix_logins).
MATRIX_TABLE=matrix_logins
MATRIX_USER_COLUMN=username
MATRIX_PASS_COLUMN=password_hash

# --- AuthMe shim (MatrixStats plugin) -------------------------------------
# The plugin auto-generates a shared secret and a self-signed PEM cert in
# its data folder (plugins/MatrixStats/) on first start. Copy them here.
AUTHME_SHIM_URL=https://127.0.0.1:8081
AUTHME_SHIM_SECRET=
AUTHME_SHIM_CA_PATH=
# Dev-only escape hatch: trust the shim cert without verification.
# AUTHME_SHIM_INSECURE=1
# AUTHME_SHIM_TIMEOUT_MS=6000

# --- Frontend (Vite) ------------------------------------------------------
# Vite variables must start with VITE_. The dev server proxies /api to 8787,
# so leaving this blank is fine for `npm run dev`.
# VITE_API_BASE=https://api.example.com
