# Copy this file to .deploy.env and fill in the values for your Linux host.

DEPLOY_HOST=192.168.1.10
DEPLOY_PORT=22
DEPLOY_USER=youruser
DEPLOY_PATH=/srv/my-site

# Optional: use an SSH key instead of your default agent/key.
# DEPLOY_KEY=C:/Users/you/.ssh/id_ed25519

# How to restart the app after files are copied.
# For a user service, this is usually the easiest option.
DEPLOY_SERVICE=my-site

# Optional overrides:
# DEPLOY_INSTALL_CMD=npm ci --omit=dev
# DEPLOY_RESTART_CMD=systemctl --user restart my-site

# Build-time frontend API base. Use the public URL the browser should call.
# For direct access on port 8787, this can be left unset.
# If you use nginx/caddy on 443, set it to https://your-domain
# VITE_API_BASE=https://your-domain
