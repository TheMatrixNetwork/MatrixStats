[Unit]
Description=MatrixSite Backend
After=network.target mariadb.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/srv/mysite-backend
ExecStart=/bin/bash /srv/mysite-backend/start.sh
Restart=always
RestartSec=3

# start.sh loads /srv/mysite-backend/my-site.env before launching the backend.
# If your Linux node binary is elsewhere, set NODE_BIN in the env file.

[Install]
WantedBy=default.target
