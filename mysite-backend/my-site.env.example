# Copy this file to my-site.env and replace the placeholder values.
# This file is meant for the Linux backend host. Keep it out of git.

PORT=8787
NODE_ENV=production

# --- Database -------------------------------------------------------------
DB_DRIVER=mariadb
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace_me
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=replace_me

# --- Session / cookies ----------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret
SESSION_TTL_MINUTES=60
REMEMBER_TTL_DAYS=7
# When the frontend is served from a different origin behind HTTPS:
COOKIE_SAMESITE=none
COOKIE_SECURE=1

# --- Admins ---------------------------------------------------------------
ADMIN_USERS=replace_me

# --- Auth provider --------------------------------------------------------
# "authme"        -> delegates verify / change-password to the MatrixStats
#                    Bukkit plugin over HTTPS.
# "matrix_logins" -> uses MATRIX_TABLE bcrypt logins.
AUTH_PROVIDER=authme

MATRIX_TABLE=matrix_logins
MATRIX_USER_COLUMN=username
MATRIX_PASS_COLUMN=password_hash

# --- AuthMe shim (MatrixStats plugin) -------------------------------------
# The plugin auto-generates both values in plugins/MatrixStats/config.yml
# (shared-secret) and plugins/MatrixStats/auth-shim-cert.pem (CA).
# Copy them onto this host and point the env vars at them.
AUTHME_SHIM_URL=https://127.0.0.1:8081
AUTHME_SHIM_SECRET=replace_me_with_value_from_plugin_config_yml
AUTHME_SHIM_CA_PATH=/etc/matrixstats/auth-shim-cert.pem
# AUTHME_SHIM_TIMEOUT_MS=6000
# Only set this if you absolutely cannot ship the PEM (dev fallback):
# AUTHME_SHIM_INSECURE=1

# --- Cross-site frontend hosting ------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=https://replace-me.example
FRONTEND_ORIGIN=https://replace-me.example

# Optional: only needed if your frontend build needs a public API URL.
# VITE_API_BASE=https://api.replace-me.example

# --- Optional integrations ------------------------------------------------
# LP_PLAYERS_TABLE=luckperms_players
# BQ_QUESTS_TABLE=bq_player_quests
# BQ_PROVIDER=beautyquests:players
