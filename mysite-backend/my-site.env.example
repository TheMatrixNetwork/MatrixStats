# Copy this file to my-site.env and replace the placeholder values.
# This file is meant for the Linux backend host.

PORT=8787
NODE_ENV=production

# Database
DB_DRIVER=mariadb
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace_me
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=replace_me

# Session / auth
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERS=replace_me
AUTH_PROVIDER=matrix_logins
MATRIX_TABLE=matrix_logins
MATRIX_USER_COLUMN=username
MATRIX_PASS_COLUMN=password_hash

# Cross-site frontend hosting
# Put the exact frontend origin(s) here, separated by commas.
# Example: https://example.com,https://www.example.com
CORS_ORIGINS=https://replace-me.example
FRONTEND_ORIGIN=https://replace-me.example

# Cookies for cross-site frontend access
COOKIE_SAMESITE=none
COOKIE_SECURE=1

# Optional: set if your frontend build needs a public API URL.
# VITE_API_BASE=https://api.replace-me.example
